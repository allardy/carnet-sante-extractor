{
  "name": "carnet-sante-extract",
  "version": "0.1.0",
  "private": true,
  "description": "Extract your health records (PDFs + structured data) from Carnet Santé Québec into AI-ready Markdown/JSON.",
  "bin": {
    "carnet-extract": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:type": "tsc --noEmit -p tsconfig.json",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt .",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:type",
    "fix": "pnpm fix:format && pnpm fix:lint"
  },
  "dependencies": {
    "playwright": "^1.49.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "^0.43.0",
    "@oxlint/binding-win32-x64-msvc": "^1.58.0",
    "@rolldown/binding-win32-x64-msvc": "1.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.19.17",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright"
    ]
  }
}